<urn:hvac-sim:generated-scenario> a owl:Ontology ;
    rdfs:label "Generated HVAC Simulation Scenario" ;
    owl:imports <https://brickschema.org/schema/1.4/Brick> .

# Generated by hvac-sim. Equipment sizing defaults:
# - 1 AHU per 10 terminal units
# - 1 chiller and boiler per 50 terminal units
# - 1 cooling tower per chiller
# - Network mode: one subnet per building

# ============================================================================
# Building1: 20 terminal units, 2 AHUs
# ============================================================================

scenario:Building1 a brick:Building ;
    rdfs:label "Building 1" ;
    brick:area [ brick:hasUnits unit:FT_2 ;
            brick:value "8000" ] ;
    bacnet:networkNumber 100 ;
    scenario:ipSubnet "10.1.0.0/24" .

