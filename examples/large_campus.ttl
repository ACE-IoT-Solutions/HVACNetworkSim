@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix campus: <http://example.org/campus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Large Campus Simulation Example
# ================================
# 5 Buildings, 12 AHUs, 100+ VAVs, Central Plant
#
# Building Summary:
#   - Administration (Bldg A): 2 AHUs, 16 VAVs, 40,000 sq ft
#   - Engineering (Bldg B): 3 AHUs, 30 VAVs, 75,000 sq ft
#   - Student Center (Bldg C): 2 AHUs, 20 VAVs, 50,000 sq ft
#   - Library (Bldg D): 2 AHUs, 18 VAVs, 45,000 sq ft
#   - Research Lab (Bldg E): 3 AHUs, 24 VAVs, 60,000 sq ft
#
# Central Plant:
#   - 2 Chillers (800 tons each)
#   - 2 Boilers (2000 MBH each)
#   - 2 Cooling Towers

<urn:large-campus> a owl:Ontology ;
    rdfs:label "Large Campus HVAC Simulation" ;
    owl:imports <https://brickschema.org/schema/1.4/Brick> .

# =============================================================================
# BUILDING A - Administration Building
# 3 floors, executive offices, conference rooms
# =============================================================================

campus:BuildingA a brick:Building ;
    rdfs:label "Administration Building" ;
    brick:area [ brick:hasUnits unit:FT_2 ; brick:value "40000" ] .

# Building A - AHU-A1 (Floors 1-2)
campus:BuildingA_AHU_A1 a brick:Air_Handler_Unit ;
    brick:isPartOf campus:BuildingA ;
    brick:feeds campus:BuildingA_VAV_A101, campus:BuildingA_VAV_A102, campus:BuildingA_VAV_A103,
        campus:BuildingA_VAV_A104, campus:BuildingA_VAV_A105, campus:BuildingA_VAV_A106,
        campus:BuildingA_VAV_A107, campus:BuildingA_VAV_A108 ;
    brick:isFedBy campus:CentralPlant_Chiller1 .

# Building A - AHU-A2 (Floor 3 - Executive)
campus:BuildingA_AHU_A2 a brick:Air_Handler_Unit ;
    brick:isPartOf campus:BuildingA ;
    brick:feeds campus:BuildingA_VAV_A201, campus:BuildingA_VAV_A202, campus:BuildingA_VAV_A203,
        campus:BuildingA_VAV_A204, campus:BuildingA_VAV_A205, campus:BuildingA_VAV_A206,
        campus:BuildingA_VAV_A207, campus:BuildingA_VAV_A208 ;
    brick:isFedBy campus:CentralPlant_Chiller1 .

# Building A - Floor 1-2 VAVs (AHU-A1)
campus:BuildingA_VAV_A101 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A101 .
campus:BuildingA_VAV_A102 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A102 .
campus:BuildingA_VAV_A103 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A103 .
campus:BuildingA_VAV_A104 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A104 .
campus:BuildingA_VAV_A105 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A105 .
campus:BuildingA_VAV_A106 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A106 .
campus:BuildingA_VAV_A107 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A107 .
campus:BuildingA_VAV_A108 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A108 .

# Building A - Floor 3 VAVs (AHU-A2 - Executive)
campus:BuildingA_VAV_A201 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A201 .
campus:BuildingA_VAV_A202 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A202 .
campus:BuildingA_VAV_A203 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A203 .
campus:BuildingA_VAV_A204 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A204 .
campus:BuildingA_VAV_A205 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A205 .
campus:BuildingA_VAV_A206 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A206 .
campus:BuildingA_VAV_A207 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A207 .
campus:BuildingA_VAV_A208 a brick:VAV ; brick:isPartOf campus:BuildingA ; brick:feeds campus:BuildingA_Zone_A208 .

# Building A Zones
campus:BuildingA_Zone_A101 a brick:HVAC_Zone ; brick:isPartOf campus:BuildingA .
campus:BuildingA_Zone_A102 a brick:HVAC_Zone ; brick:isPartOf campus:BuildingA .
campus:BuildingA_Zone_A103 a brick:HVAC_Zone ; brick:isPartOf campus:BuildingA .
campus:BuildingA_Zone_A104 a brick:HVAC_Zone ; brick:isPartOf campus:BuildingA .
