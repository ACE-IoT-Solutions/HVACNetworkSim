# =============================================================================
# BUILDING E - Research Lab
# 3 floors, wet labs, dry labs, cleanrooms
# =============================================================================

campus:BuildingE a brick:Building ;
    rdfs:label "Research Lab" ;
    brick:area [ brick:hasUnits unit:FT_2 ; brick:value "60000" ] .

# Building E - AHU-E1 (Floor 1 - Wet Labs, 100% outside air)
campus:BuildingE_AHU_E1 a brick:Air_Handler_Unit ;
    brick:isPartOf campus:BuildingE ;
    brick:feeds campus:BuildingE_VAV_E101, campus:BuildingE_VAV_E102, campus:BuildingE_VAV_E103,
        campus:BuildingE_VAV_E104, campus:BuildingE_VAV_E105, campus:BuildingE_VAV_E106,
        campus:BuildingE_VAV_E107, campus:BuildingE_VAV_E108 ;
    brick:isFedBy campus:CentralPlant_Chiller1 .

# Building E - AHU-E2 (Floor 2 - Dry Labs)
campus:BuildingE_AHU_E2 a brick:Air_Handler_Unit ;
    brick:isPartOf campus:BuildingE ;
    brick:feeds campus:BuildingE_VAV_E201, campus:BuildingE_VAV_E202, campus:BuildingE_VAV_E203,
        campus:BuildingE_VAV_E204, campus:BuildingE_VAV_E205, campus:BuildingE_VAV_E206,
