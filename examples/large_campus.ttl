# =============================================================================
# CENTRAL PLANT - Shared Campus Infrastructure
# =============================================================================

campus:CentralPlant a brick:Building ;
    rdfs:label "Central Plant" ;
    brick:area [ brick:hasUnits unit:FT_2 ; brick:value "5000" ] .

# Chillers
campus:CentralPlant_Chiller1 a brick:Chiller ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Chiller-1 (800 tons)" .

campus:CentralPlant_Chiller2 a brick:Chiller ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Chiller-2 (800 tons)" .

# Boilers
campus:CentralPlant_Boiler1 a brick:Boiler ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Boiler-1 (2000 MBH)" .

campus:CentralPlant_Boiler2 a brick:Boiler ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Boiler-2 (2000 MBH)" .

# Cooling Towers
campus:CentralPlant_CoolingTower1 a brick:Cooling_Tower ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Cooling Tower-1" .

campus:CentralPlant_CoolingTower2 a brick:Cooling_Tower ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Cooling Tower-2" .

# Pumps
campus:CentralPlant_CHWP1 a brick:Chilled_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Primary CHW Pump-1" .

campus:CentralPlant_CHWP2 a brick:Chilled_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Primary CHW Pump-2" .

campus:CentralPlant_CWP1 a brick:Condenser_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Condenser Water Pump-1" .

campus:CentralPlant_CWP2 a brick:Condenser_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Condenser Water Pump-2" .

campus:CentralPlant_HWP1 a brick:Hot_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Hot Water Pump-1" .

campus:CentralPlant_HWP2 a brick:Hot_Water_Pump ;
    brick:isPartOf campus:CentralPlant ;
    rdfs:label "Hot Water Pump-2" .
