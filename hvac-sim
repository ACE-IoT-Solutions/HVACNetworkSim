#!/usr/bin/env python3
"""
HVAC Simulator CLI - A simple command to run the containerized HVAC BACnet simulation.

Usage:
    # Run simple simulation
    ./hvac-sim

    # Run with a brick file
    ./hvac-sim data/brick_schemas/bldg36.ttl

    # Run with custom device ID
    ./hvac-sim --device-id 1000 data/brick_schemas/bldg36.ttl

    # Run multi-container campus simulation
    ./hvac-sim --campus examples/multi_building_campus.ttl

    # Run the built-in multi-network collision campus scenario
    ./hvac-sim --campus --campus-scenario multi-network-collisions

    # Run the BBMD asymmetry campus scenario
    ./hvac-sim --campus --campus-scenario multi-network-bdt-asymmetry

    # List available brick files
    ./hvac-sim --list
"""

import argparse
import subprocess
import sys
from pathlib import Path

from src.core.env_validation import (
    EnvironmentValidationError,
    format_container_command,
    parse_extra_env_var,
    validate_bacnet_device_id,
    validate_bacnet_port,
)


# Container configuration
IMAGE_NAME = "hvac-simulator"
BBMD_IMAGE_NAME = "ace-acl-bbmd"
CONTAINER_NAME = "hvac-bacnet-sim"
DEFAULT_PORT = 47808
BRICK_MOUNT_PATH = "/app/brick_schemas"
CUSTOM_SCRIPT_MOUNT_PATH = "/app/custom_scripts"
CAMPUS_COMPOSE_FILE = "docker-compose.campus.yml"
CAMPUS_SCENARIOS = (
    "default",
    "multi-network",
    "multi-network-collisions",
    "multi-network-bdt-asymmetry",
    "multi-network-duplicate-router-claim",
)


def find_brick_files(search_dir: Path = None) -> list[Path]:
    """Find all .ttl brick schema files in the data directory."""
    if search_dir is None:
        search_dir = Path(__file__).parent / "data" / "brick_schemas"

    if not search_dir.exists():
        return []

    return sorted(search_dir.glob("*.ttl"))


def list_brick_files():
    """List all available brick schema files."""
    files = find_brick_files()

    if not files:
        print("No brick schema files found in data/brick_schemas/")
        print("\nPlace your .ttl files in data/brick_schemas/ or specify a full path.")
        return

    print("Available Brick schema files:")
    print("-" * 50)
    for f in files:
        size = f.stat().st_size
        print(f"  {f.name:30} ({size:,} bytes)")
    print("-" * 50)
    print(f"\nUsage: ./hvac-sim {files[0].name}")


def check_container_runtime() -> str:
    """Check if podman or docker is available, preferring podman."""
    for runtime in ["podman", "docker"]:
        try:
            result = subprocess.run(
                [runtime, "--version"], capture_output=True, text=True, timeout=5
            )
            if result.returncode == 0:
                return runtime
        except (subprocess.SubprocessError, FileNotFoundError):
            continue

    print("Error: Neither podman nor docker found.", file=sys.stderr)
    print("Please install podman or docker to run the simulation.", file=sys.stderr)
    sys.exit(1)


def image_exists(runtime: str, image_name: str) -> bool:
    """Check if a container image exists (works with both podman and docker)."""
    # Use 'image inspect' which works on both podman and docker
    result = subprocess.run(
        [runtime, "image", "inspect", image_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def build_image(runtime: str, force: bool = False) -> bool:
    """Build the container image if needed."""
    # Check if image exists
    if not force and image_exists(runtime, IMAGE_NAME):
        return True

    print(f"Building {IMAGE_NAME} image...")
    script_dir = Path(__file__).parent

    result = subprocess.run(
        [runtime, "build", "--network=host", "-t", IMAGE_NAME, str(script_dir)], cwd=script_dir
    )

    if result.returncode != 0:
        print("Error: Failed to build image", file=sys.stderr)
        return False

    print(f"Image {IMAGE_NAME} built successfully.")
    return True


def stop_existing_container(runtime: str):
    """Stop and remove any existing container with our name."""
    subprocess.run(
        [runtime, "rm", "-f", CONTAINER_NAME], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )


def resolve_brick_file(brick_path: str) -> tuple[Path, str]:
    """
    Resolve a brick file path and return (host_path, container_path).

    Accepts:
    - Filename only: "bldg36.ttl" -> looks in data/brick_schemas/
    - Relative path: "data/brick_schemas/bldg36.ttl"
    - Absolute path: "/path/to/building.ttl"
    """
    brick_path = Path(brick_path)
    script_dir = Path(__file__).parent

    # If it's just a filename, look in the default brick schemas dir
    if not brick_path.parent.name:  # Just filename
        default_dir = script_dir / "data" / "brick_schemas"
        full_path = default_dir / brick_path
        if full_path.exists():
            return full_path.resolve(), f"{BRICK_MOUNT_PATH}/{brick_path.name}"

    # If relative, make absolute from script dir
    if not brick_path.is_absolute():
        brick_path = (script_dir / brick_path).resolve()
    else:
        brick_path = brick_path.resolve()

    if not brick_path.exists():
        print(f"Error: Brick file not found: {brick_path}", file=sys.stderr)
        sys.exit(1)

    # Container path is the mount point + filename
    container_path = f"{BRICK_MOUNT_PATH}/{brick_path.name}"

    return brick_path, container_path


def resolve_custom_script(script_path: str) -> tuple[Path, str]:
    """Resolve a custom Python script path for mounting into the container."""
    script = Path(script_path)
    script_dir = Path(__file__).parent

    if not script.is_absolute():
        script = (script_dir / script).resolve()
    else:
        script = script.resolve()

    if not script.exists():
        print(f"Error: Custom script not found: {script}", file=sys.stderr)
        sys.exit(1)

    if script.suffix != ".py":
        print("Error: Custom scripts must be Python files (*.py)", file=sys.stderr)
        sys.exit(1)

    return script, f"{CUSTOM_SCRIPT_MOUNT_PATH}/{script.name}"


def run_simulation(
    runtime: str,
    brick_file: str = None,
    custom_script: str = None,
    device_id: int = None,
    port: int = DEFAULT_PORT,
    detach: bool = False,
    network_mode: str = None,
    allow_host_network: bool = False,
    allow_custom_script: bool = False,
    extra_env: dict = None,
):
    """Run the HVAC simulation container."""

    if network_mode == "host" and not allow_host_network:
        print(
            "Error: host networking requires --allow-host-network to acknowledge external access.",
            file=sys.stderr,
        )
        return 1

    if brick_file and custom_script:
        print("Error: --custom-script cannot be combined with a Brick TTL file.", file=sys.stderr)
        return 1

    if custom_script and not allow_custom_script:
        print(
            "Error: --custom-script requires --allow-custom-script to acknowledge arbitrary code execution.",
            file=sys.stderr,
        )
        return 1

    cmd = [runtime, "run"]

    # Container name and cleanup
    cmd.extend(["--name", CONTAINER_NAME])
    if not detach:
        cmd.append("--rm")

    # Interactive/detach mode
    if detach:
        cmd.append("-d")
    else:
        cmd.extend(["-it"])

    # Network configuration
    if network_mode:
        cmd.extend(["--network", network_mode])

    # Environment variables
    env_vars = {}

    if extra_env:
        env_vars.update(extra_env)

    if custom_script:
        host_path, container_path = resolve_custom_script(custom_script)
        mount_dir = host_path.parent
        cmd.extend(["-v", f"{mount_dir}:{CUSTOM_SCRIPT_MOUNT_PATH}:ro"])
        env_vars["SIMULATION_MODE"] = "custom"
        env_vars["ALLOW_CUSTOM_SCRIPT"] = "true"
        env_vars["CUSTOM_SCRIPT"] = container_path
    elif brick_file:
        host_path, container_path = resolve_brick_file(brick_file)

        # Mount the brick file's directory
        mount_dir = host_path.parent
        cmd.extend(["-v", f"{mount_dir}:{BRICK_MOUNT_PATH}:ro"])

        env_vars["SIMULATION_MODE"] = "brick"
        env_vars["BRICK_TTL_FILE"] = container_path
    else:
        env_vars["SIMULATION_MODE"] = "simple"

    if device_id is not None:
        env_vars["BACNET_DEVICE_ID"] = str(device_id)

    if network_mode == "host":
        env_vars["BACNET_PORT"] = str(port)
    else:
        if env_vars.get("BACNET_PORT", str(DEFAULT_PORT)) != str(DEFAULT_PORT):
            print(
                "Error: BACNET_PORT overrides require --network host; use --port for bridge-mode publishing.",
                file=sys.stderr,
            )
            return 1
        cmd.extend(["-p", f"{port}:{DEFAULT_PORT}/udp"])

    # Add env vars to command
    for key, value in env_vars.items():
        cmd.extend(["-e", f"{key}={value}"])

    # Image name
    cmd.append(IMAGE_NAME)

    # Print the command for debugging/learning
    print(f"Running: {format_container_command(cmd)}")
    print("-" * 60)

    # Execute
    try:
        result = subprocess.run(cmd)
        return result.returncode
    except KeyboardInterrupt:
        print("\nStopping simulation...")
        stop_existing_container(runtime)
        return 0


def check_compose_runtime(runtime: str) -> str:
    """Check for podman-compose or docker-compose."""
    compose_cmd = f"{runtime}-compose"
    try:
        result = subprocess.run([compose_cmd, "version"], capture_output=True, text=True, timeout=5)
        if result.returncode == 0:
            return compose_cmd
    except (subprocess.SubprocessError, FileNotFoundError):
        pass

    # Try docker compose (v2 plugin)
    if runtime == "docker":
        try:
            result = subprocess.run(
                ["docker", "compose", "version"], capture_output=True, text=True, timeout=5
            )
            if result.returncode == 0:
                return "docker compose"
        except (subprocess.SubprocessError, FileNotFoundError):
            pass

    print(f"Error: {compose_cmd} not found.", file=sys.stderr)
    print(f"Please install {compose_cmd} to use campus mode.", file=sys.stderr)
    sys.exit(1)


def build_bbmd_image(runtime: str, force: bool = False) -> bool:
    """Build the BBMD image from the sibling ace-acl-bbmd project."""
    if not force and image_exists(runtime, BBMD_IMAGE_NAME):
        return True

    script_dir = Path(__file__).parent
    bbmd_dir = script_dir.parent / "ace-acl-bbmd"

    if not bbmd_dir.exists():
        print(f"Error: BBMD project not found at {bbmd_dir}", file=sys.stderr)
        print(
            "Campus mode requires the ace-acl-bbmd project as a sibling directory.",
            file=sys.stderr,
        )
        print(
            "Clone it with: git clone git@github.com:ACE-IoT-Solutions/ace-acl-bbmd ../ace-acl-bbmd",
            file=sys.stderr,
        )
        return False

    print(f"Building {BBMD_IMAGE_NAME} image from {bbmd_dir}...")

    # The ace-acl-bbmd project keeps its Dockerfile at integration_testing/Dockerfile.bbmd
    # with build context at project root. We patch it to:
    # 1. Copy README.md (needed by hatchling)
    # 2. Use uv bookworm (non-slim) base which includes gcc + python3-dev,
    #    avoiding apt-get calls that fail without network access to deb.debian.org.
    dockerfile = bbmd_dir / "integration_testing" / "Dockerfile.bbmd"
    if dockerfile.exists():
        import tempfile

        patched_content = dockerfile.read_text()
        patched_content = patched_content.replace(
            "FROM python:3.13-slim",
            "FROM ghcr.io/astral-sh/uv:python3.13-bookworm",
        )
        patched_content = patched_content.replace(
            "COPY pyproject.toml uv.lock ./",
            "COPY pyproject.toml uv.lock README.md ./",
        )
        # Remove the apt-get step — gcc and python headers are in the base image
        import re

        patched_content = re.sub(
            r"# Install system dependencies\nRUN apt-get update.*?rm -rf /var/lib/apt/lists/\*\n",
            "",
            patched_content,
            flags=re.DOTALL,
        )
        # uv is already in the base image, just use it directly
        patched_content = patched_content.replace(
            "RUN pip install uv && \\\n    uv pip install --system -e .",  # noqa: W605
            "RUN uv sync --no-dev",
        )
        # Ensure the venv bin dir is on PATH so ace-acl-bbmd is found by name
        patched_content = patched_content.replace(
            "WORKDIR /app",
            'WORKDIR /app\nENV PATH="/app/.venv/bin:$PATH"',
        )
        with tempfile.NamedTemporaryFile(mode="w", suffix=".Dockerfile", delete=False) as f:
            f.write(patched_content)
            patched_path = f.name
        try:
            result = subprocess.run(
                [
                    runtime,
                    "build",
                    "--network=host",
                    "-f",
                    patched_path,
                    "-t",
                    BBMD_IMAGE_NAME,
                    str(bbmd_dir),
                ],
                cwd=bbmd_dir,
            )
        finally:
            Path(patched_path).unlink(missing_ok=True)
    else:
        result = subprocess.run(
            [runtime, "build", "--network=host", "-t", BBMD_IMAGE_NAME, str(bbmd_dir)], cwd=bbmd_dir
        )

    if result.returncode != 0:
        print(f"Error: Failed to build {BBMD_IMAGE_NAME} image", file=sys.stderr)
        return False

    print(f"Image {BBMD_IMAGE_NAME} built successfully.")
    return True


def run_campus_generate(
    ttl_file: str | None,
    expose_bacnet: bool = False,
    scenario: str = "default",
) -> bool:
    """Run the campus generator script."""
    script_dir = Path(__file__).parent
    generator = script_dir / "campus" / "generate_campus.py"

    if not generator.exists():
        print(f"Error: Campus generator not found: {generator}", file=sys.stderr)
        return False

    cmd = [sys.executable, str(generator), "--scenario", scenario]
    if expose_bacnet:
        cmd.append("--expose-bacnet")
    if ttl_file:
        cmd.append(ttl_file)

    result = subprocess.run(cmd, cwd=script_dir)
    return result.returncode == 0


def run_campus(
    runtime: str,
    ttl_file: str | None,
    build: bool = False,
    expose_bacnet: bool = False,
    scenario: str = "default",
) -> int:
    """Generate and start a campus simulation."""
    script_dir = Path(__file__).parent
    compose_file = script_dir / CAMPUS_COMPOSE_FILE

    # Generate compose and configs
    print("Generating campus configuration...")
    if not run_campus_generate(ttl_file, expose_bacnet=expose_bacnet, scenario=scenario):
        return 1

    if not compose_file.exists():
        print(f"Error: {compose_file} was not generated", file=sys.stderr)
        return 1

    # Build images
    if not build_image(runtime, force=build):
        return 1
    if not build_bbmd_image(runtime, force=build):
        return 1

    # Find compose runtime
    compose_cmd = check_compose_runtime(runtime)

    # Start the campus
    print("\nStarting campus simulation...")
    if " " in compose_cmd:
        # docker compose (plugin form)
        parts = compose_cmd.split()
        cmd = parts + ["-f", str(compose_file), "up", "-d"]
    else:
        cmd = [compose_cmd, "-f", str(compose_file), "up", "-d"]

    result = subprocess.run(cmd, cwd=script_dir)
    if result.returncode != 0:
        return result.returncode

    print("\nCampus simulation started. Use './hvac-sim --campus-logs' to view logs.")
    print("Use './hvac-sim --campus-stop' to stop.")
    return 0


def stop_campus(runtime: str) -> int:
    """Stop the campus simulation."""
    script_dir = Path(__file__).parent
    compose_file = script_dir / CAMPUS_COMPOSE_FILE

    if not compose_file.exists():
        print(f"No campus compose file found at {compose_file}", file=sys.stderr)
        return 1

    compose_cmd = check_compose_runtime(runtime)
    if " " in compose_cmd:
        parts = compose_cmd.split()
        cmd = parts + ["-f", str(compose_file), "down"]
    else:
        cmd = [compose_cmd, "-f", str(compose_file), "down"]

    result = subprocess.run(cmd, cwd=script_dir)
    return result.returncode


def campus_logs(runtime: str) -> int:
    """Show campus simulation logs."""
    script_dir = Path(__file__).parent
    compose_file = script_dir / CAMPUS_COMPOSE_FILE

    if not compose_file.exists():
        print(f"No campus compose file found at {compose_file}", file=sys.stderr)
        return 1

    compose_cmd = check_compose_runtime(runtime)
    if " " in compose_cmd:
        parts = compose_cmd.split()
        cmd = parts + ["-f", str(compose_file), "logs", "-f"]
    else:
        cmd = [compose_cmd, "-f", str(compose_file), "logs", "-f"]

    try:
        result = subprocess.run(cmd, cwd=script_dir)
        return result.returncode
    except KeyboardInterrupt:
        return 0


def main():
    parser = argparse.ArgumentParser(
        description="Run the HVAC BACnet Simulator in a container",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s                          Run simple VAV simulation
  %(prog)s bldg36.ttl               Run with brick file from data/brick_schemas/
  %(prog)s /path/to/building.ttl    Run with brick file from custom path
  %(prog)s --list                   List available brick schema files
  %(prog)s -d bldg36.ttl            Run in background (detached)
  %(prog)s --port 47809 bldg36.ttl  Use custom BACnet port
  %(prog)s --campus                 Run the default built-in campus example
  %(prog)s --campus --campus-scenario multi-network
                                    Run the built-in multi-network campus scenario
  %(prog)s --campus --campus-scenario multi-network-bdt-asymmetry
                                    Run the BBMD asymmetry campus scenario
        """,
    )

    parser.add_argument(
        "brick_file", nargs="?", help="Brick TTL file (filename, relative, or absolute path)"
    )

    parser.add_argument(
        "-l", "--list", action="store_true", help="List available brick schema files"
    )

    parser.add_argument("-d", "--detach", action="store_true", help="Run container in background")

    parser.add_argument(
        "--device-id", type=int, metavar="ID", help="BACnet device instance ID (default: 599)"
    )

    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=DEFAULT_PORT,
        metavar="PORT",
        help=f"Host port for BACnet UDP (default: {DEFAULT_PORT})",
    )

    parser.add_argument(
        "--network",
        metavar="MODE",
        help="Container network mode (e.g., 'host' for BACnet discovery)",
    )

    parser.add_argument(
        "--allow-host-network",
        action="store_true",
        help="Acknowledge the risks of exposing the simulator directly on the host network",
    )

    parser.add_argument("--build", action="store_true", help="Force rebuild the container image")

    parser.add_argument("--stop", action="store_true", help="Stop the running simulation container")

    parser.add_argument(
        "--logs", action="store_true", help="Show logs from running/stopped container"
    )

    parser.add_argument(
        "-e",
        "--env",
        action="append",
        metavar="KEY=VALUE",
        help="Set additional BACnet runtime variables (BACNET_ADDRESS/IP/SUBNET/PORT/DEVICE_ID/NETWORK_NUMBER only)",
    )

    parser.add_argument(
        "--custom-script",
        metavar="PATH",
        help="Run a mounted custom Python script inside the container",
    )

    parser.add_argument(
        "--allow-custom-script",
        action="store_true",
        help="Acknowledge arbitrary code execution when using --custom-script",
    )

    # Campus mode options
    parser.add_argument(
        "--campus",
        nargs="?",
        const="",
        metavar="TTL_FILE",
        help="Run multi-container campus simulation (omit TTL to use the scenario example)",
    )

    parser.add_argument(
        "--campus-scenario",
        choices=CAMPUS_SCENARIOS,
        default="default",
        help="Campus scenario profile to generate when using --campus",
    )

    parser.add_argument(
        "--campus-stop",
        action="store_true",
        help="Stop the running campus simulation",
    )

    parser.add_argument(
        "--campus-logs",
        action="store_true",
        help="Show logs from the campus simulation",
    )

    parser.add_argument(
        "--expose-campus-bacnet",
        action="store_true",
        help="Publish campus BBMD UDP ports and allow foreign-device registration",
    )

    args = parser.parse_args()

    # Handle --list
    if args.list:
        list_brick_files()
        return 0

    # Detect container runtime
    runtime = check_container_runtime()
    print(f"Using container runtime: {runtime}")

    # Handle campus commands
    if args.campus_stop:
        return stop_campus(runtime)

    if args.campus_logs:
        return campus_logs(runtime)

    if args.campus is not None:
        return run_campus(
            runtime,
            args.campus or None,
            build=args.build,
            expose_bacnet=args.expose_campus_bacnet,
            scenario=args.campus_scenario,
        )

    # Handle --stop
    if args.stop:
        print(f"Stopping {CONTAINER_NAME}...")
        stop_existing_container(runtime)
        print("Stopped.")
        return 0

    # Handle --logs
    if args.logs:
        subprocess.run([runtime, "logs", "-f", CONTAINER_NAME])
        return 0

    # Build image if needed
    if not build_image(runtime, force=args.build):
        return 1

    # Stop any existing container
    stop_existing_container(runtime)

    # Parse extra environment variables
    extra_env = {}
    if args.env:
        for env_str in args.env:
            if "=" not in env_str:
                print(f"Error: invalid environment variable assignment: {env_str}", file=sys.stderr)
                return 1
            key, value = env_str.split("=", 1)
            try:
                validated_key, validated_value = parse_extra_env_var(key, value)
            except EnvironmentValidationError as exc:
                print(f"Error: {exc}", file=sys.stderr)
                return 1
            extra_env[validated_key] = validated_value

    try:
        args.port = validate_bacnet_port(args.port, variable_name="--port")
        if args.device_id is not None:
            args.device_id = validate_bacnet_device_id(args.device_id, variable_name="--device-id")
    except EnvironmentValidationError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    # Run the simulation
    return run_simulation(
        runtime=runtime,
        brick_file=args.brick_file,
        custom_script=args.custom_script,
        device_id=args.device_id,
        port=args.port,
        detach=args.detach,
        network_mode=args.network,
        allow_host_network=args.allow_host_network,
        allow_custom_script=args.allow_custom_script,
        extra_env=extra_env,
    )


if __name__ == "__main__":
    sys.exit(main())
